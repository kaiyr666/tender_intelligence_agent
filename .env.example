# Copy this file to .env (cp .env.example .env) and fill in your key.
# .env is never committed and Claude Code is blocked from reading it.

# Which model the PRODUCT uses (your Claude/ChatGPT subscriptions cover the tools, not this).
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5

# Fill in the key for the provider above.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
